{
  "rewrites": [
    {
      "source": "/organizzatore",
      "destination": "/index.html"
    },
    {
      "source": "/organizzatore/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/push/cron",
      "schedule": "* * * * *"
    }
  ]
}
